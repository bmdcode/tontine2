rules_version = '2';
// Règles Tontine 2.0 : seuls les responsables connectés lisent et écrivent.
// Coller dans Firebase > Firestore Database > Règles, puis « Publier ».
service cloud.firestore {
  match /databases/{database}/documents {
    match /tontines/{tontine}/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
